# Öffentliche Adresse (bestimmt auch Secure-Cookies und die OIDC-Redirect-URL)
MS_BASE_URL=https://meldungen.example.de
MS_APP_NAME=Meldestelle

# Hinter einem Reverse Proxy (Caddy) die Client-IP aus X-Forwarded-For übernehmen
MS_TRUST_PROXY=true

# Lokale Konten
MS_LOCAL_LOGIN=true
MS_ALLOW_REGISTRATION=true

# Anhänge
MS_MAX_UPLOAD_MB=20
MS_MAX_FILES=5

# LDAP / Active Directory (leer lassen = deaktiviert), Details im README
MS_LDAP_URL=
# MS_LDAP_STARTTLS=true
# MS_LDAP_CA_FILE=/run/secrets/root-ca.pem
MS_LDAP_BIND_DN=
MS_LDAP_BIND_PASSWORD=
# MS_LDAP_BIND_PASSWORD_FILE=/run/secrets/ldap_bind
MS_LDAP_BASE_DN=
MS_LDAP_REQUIRED_GROUP=
MS_LDAP_ADMIN_GROUP=
MS_LDAP_NESTED_GROUPS=true

# E-Mail-Benachrichtigungen (leer lassen = deaktiviert)
MS_SMTP_HOST=
MS_SMTP_PORT=587
MS_SMTP_TLS=starttls
MS_SMTP_USER=
MS_SMTP_PASSWORD=
MS_SMTP_FROM=Meldestelle <meldestelle@example.de>

# Virenscan der Anhänge (siehe docker-compose.yml)
# MS_CLAMAV_ADDR=tcp://clamav:3310
# MS_CLAMAV_REQUIRED=true

# Begrenzung pro Konto und Stunde (Entwickler/Admins ausgenommen)
MS_LIMIT_REPORTS_PER_HOUR=10
MS_LIMIT_REPLIES_PER_HOUR=60

# Automatische Sicherungen
MS_BACKUP_DIR=/backups
MS_BACKUP_INTERVAL_HOURS=24
MS_BACKUP_KEEP=14

# OpenID Connect (leer lassen = deaktiviert)
MS_OIDC_ISSUER=
MS_OIDC_CLIENT_ID=
MS_OIDC_CLIENT_SECRET=
# MS_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_secret
MS_OIDC_LABEL=Mit SSO anmelden
# Mitglieder dieser Gruppe werden automatisch Administratoren (Claim siehe MS_OIDC_GROUPS_CLAIM)
MS_OIDC_ADMIN_GROUP=
MS_OIDC_GROUPS_CLAIM=groups
MS_OIDC_SCOPES=openid profile email
