# Öffentliche Adresse (bestimmt auch Secure-Cookies und die OIDC-Redirect-URL)
MS_BASE_URL=https://meldungen.example.de
MS_APP_NAME=Meldestelle

# Hinter einem Reverse Proxy (Caddy) die Client-IP aus X-Forwarded-For übernehmen
MS_TRUST_PROXY=true

# Lokale Konten
MS_LOCAL_LOGIN=true
MS_ALLOW_REGISTRATION=true

# Anhänge
MS_MAX_UPLOAD_MB=20
MS_MAX_FILES=5

# OpenID Connect (leer lassen = deaktiviert)
MS_OIDC_ISSUER=
MS_OIDC_CLIENT_ID=
MS_OIDC_CLIENT_SECRET=
# MS_OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_secret
MS_OIDC_LABEL=Mit SSO anmelden
# Mitglieder dieser Gruppe werden automatisch Administratoren (Claim siehe MS_OIDC_GROUPS_CLAIM)
MS_OIDC_ADMIN_GROUP=
MS_OIDC_GROUPS_CLAIM=groups
MS_OIDC_SCOPES=openid profile email
